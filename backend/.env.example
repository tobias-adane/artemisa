# Copiar a .env y completar con credenciales reales.
# Sin ninguna de estas, el servicio arranca igual en modo mock
# (InMemoryStore + clientes que fallan explícitamente recién si se
# invoca una llamada real) — ver config.py y clients/base.py.

OPENAI_API_KEY=
GROQ_API_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Interruptor legal del autodial al 911 (Paso 4, Nivel 4). Default false
# — dejar así hasta resolver la consulta legal en backend/CLAUDE.md.
ENABLE_911_AUTODIAL=false

SENTRY_DSN=
