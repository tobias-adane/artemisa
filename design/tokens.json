{
  "$description": "Tokens de diseño de Artemisa. Fuente: docs/09-DISENO.md. Si cambian allá, se actualizan acá.",
  "color": {
    "background": "#FFFFFF",
    "foreground": "#0A0A0A",
    "card": "#FFFFFF",
    "muted": "#F5F5F5",
    "muted-foreground": "#737373",
    "primary": "#171717",
    "primary-foreground": "#FAFAFA",
    "border": "#E5E5E5",
    "input": "#E5E5E5",
    "ring": "#A3A3A3",
    "destructive": "#0A0A0A"
  },
  "state": {
    "normal": "#22C55E",
    "attention": "#D08700",
    "emergency": "#DC2626",
    "offline": "#737373"
  },
  "font": {
    "serif": {
      "family": "Instrument Serif",
      "expo": "InstrumentSerif_400Regular",
      "weights": [
        400
      ]
    },
    "sans": {
      "family": "Inter",
      "expo": [
        "Inter_400Regular",
        "Inter_500Medium",
        "Inter_600SemiBold"
      ],
      "weights": [
        400,
        500,
        600
      ]
    }
  },
  "type": {
    "display": {
      "font": "serif",
      "size": 34,
      "lineHeight": 40
    },
    "title": {
      "font": "serif",
      "size": 28,
      "lineHeight": 34
    },
    "body-lg": {
      "font": "sans",
      "weight": 400,
      "size": 17,
      "lineHeight": 24
    },
    "body": {
      "font": "sans",
      "weight": 400,
      "size": 15,
      "lineHeight": 22
    },
    "label": {
      "font": "sans",
      "weight": 500,
      "size": 13,
      "lineHeight": 18
    },
    "caption": {
      "font": "sans",
      "weight": 400,
      "size": 12,
      "lineHeight": 16
    }
  },
  "radius": {
    "chip": 8,
    "control": 16,
    "item": 20,
    "card": 28,
    "sheet": 34,
    "pill": 999
  },
  "space": [
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    40,
    48
  ],
  "layout": {
    "screenMargin": 20,
    "detailSectionGap": 24
  },
  "icon": {
    "library": "lucide-react-native",
    "strokeWidth": 2,
    "size": 20,
    "sizeTopBar": 24
  },
  "motion": {
    "maxDurationMs": 300,
    "properties": [
      "transform",
      "opacity"
    ],
    "enterFrom": {
      "scale": 0.95,
      "opacity": 0
    },
    "neverEaseIn": true
  },
  "rules": [
    "Negro, blanco y gris. El color solo indica estado.",
    "state.emergency es exclusivo de emergency: nunca para errores, borrar ni cancelar.",
    "destructive se mapea a foreground, no a rojo.",
    "Instrument Serif solo en títulos, máximo 2 por pantalla."
  ]
}
