# Copiar a .env.local y completar. Sin ninguna de estas, el frontend
# funciona igual contra frontend/lib/mock-data.ts — ver lib/api.ts y
# lib/supabase/{client,server}.ts.

# Backend Python (ver backend/main.py) — sin esto, se asume
# http://localhost:8000. Si no está corriendo, cada llamada de
# lib/api.ts cae silenciosamente a los datos mock.
NEXT_PUBLIC_ARTEMISA_API_URL=http://localhost:8000

# Supabase — inerte hasta que exista un proyecto real (ver
# backend/CLAUDE.md, sección Supabase).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Clerk — NO wireado todavía. Instalar @clerk/nextjs y envolver
# app/layout.tsx + middleware.ts recién cuando existan estas keys
# reales; sin ellas el middleware de Clerk tira en cada request y
# tumba la app entera (a diferencia de Supabase, acá no hay fallback
# posible). Ver el resumen de la sesión para más detalle.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
